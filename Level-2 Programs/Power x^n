public class Main {

    static double power(double x, int n) {
        long p = n;

        if (p < 0) {
            x = 1 / x;
            p = -p;
        }

        double result = 1;

        while (p > 0) {
            if (p % 2 == 1)
                result = result * x;

            x = x * x;
            p = p / 2;
        }

        return result;
    }

    public static void main(String[] args) {
        double x = 2.00000;
        int n = 10;

        System.out.printf("%.5f", power(x, n));
    }
}
