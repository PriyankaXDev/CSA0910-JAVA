import java.math.BigInteger;

public class Main {
    public static void main(String[] args) {
        String num1 = "123";
        String num2 = "456";

        BigInteger a = new BigInteger(num1);
        BigInteger b = new BigInteger(num2);

        BigInteger result = a.multiply(b);

        System.out.println("Product = " + result);
    }
}
