public class PerfectNumbers {
    public static void main(String[] args) {
        int n = 3;

        if(n <= 0) {
            System.out.println("Invalid Input");
            return;
        }

        int count = 0;
        int num = 2;

        System.out.print("First " + n + " perfect numbers are: ");

        while(count < n) {
            int sum = 0;

            for(int i = 1; i <= num / 2; i++) {
                if(num % i == 0) {
                    sum += i;
                }
            }

            if(sum == num) {
                System.out.print(num);
                count++;

                if(count < n) {
                    System.out.print(", ");
                }
            }

            num++;
        }
    }
}
