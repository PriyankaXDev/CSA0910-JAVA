public class CharacterCount {
    public static void main(String[] args) {
        char[] input = {'W','d','A','G','g','H','*'};

        int upper = 0;
        int lower = 0;
        int number = 0;

        for(char ch : input) {
            if(ch == '*')
                break;

            if(ch >= 'A' && ch <= 'Z')
                upper++;
            else if(ch >= 'a' && ch <= 'z')
                lower++;
            else if(ch >= '0' && ch <= '9')
                number++;
        }

        System.out.println("Total count of lower case: " + lower);
        System.out.println("Total count of upper case: " + upper);
        System.out.println("Total count of numbers: " + number);
    }
}
