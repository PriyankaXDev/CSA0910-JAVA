public class AverageNumbers {
    public static void main(String[] args) {
        int[] numbers = {7, -2, 9, -8, -6, -4, 10, -1};

        int positiveSum = 0, negativeSum = 0;
        int positiveCount = 0, negativeCount = 0;

        for(int num : numbers) {
            if(num == -1)
                break;

            if(num > 0) {
                positiveSum += num;
                positiveCount++;
            }
            else if(num < 0) {
                negativeSum += num;
                negativeCount++;
            }
        }

        if(negativeCount > 0)
            System.out.println("The average of negative numbers is: " + (double)negativeSum / negativeCount);
        else
            System.out.println("No negative numbers");

        if(positiveCount > 0)
            System.out.println("The average of positive numbers is: " + (double)positiveSum / positiveCount);
        else
            System.out.println("No positive numbers");
    }
}
