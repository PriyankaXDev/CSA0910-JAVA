class TableThread extends Thread {
    int number;

    TableThread(int number) {
        this.number = number;
    }

    public void run() {
        for(int i = 1; i <= 10; i++) {
            System.out.println(number + " X " + i + " = " + (number * i));
        }
    }

    public static void main(String[] args) {
        TableThread t1 = new TableThread(5);
        TableThread t2 = new TableThread(10);

        t1.start();

        try {
            t1.join();
        } catch(Exception e) {
        }

        t2.start();
    }
}
